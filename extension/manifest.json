{
  "manifest_version": 3,
  "name": "AI Agent Prompt-Injection Firewall",
  "version": "0.1.0",
  "description": "Minimum working prototype for AI Agent Prompt-Injection Firewall.",
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
